# Copy to backend/.env and edit. Every value is optional; these are the defaults.
COSMOS_MODE=live                          # live = query IRSA and JPL; demo = never touch the network
COSMOS_ALLOW_SYNTHETIC_FALLBACK=true      # if the archive is unreachable, show the labelled synthetic sample
COSMOS_SPHEREX_COLLECTIONS=spherex_qr3,spherex_dr1
COSMOS_IRSA_SIA_URL=https://irsa.ipac.caltech.edu/SIA
COSMOS_CUTOUT_SIZE_ARCSEC=600
COSMOS_MAX_EPOCHS=40
COSMOS_SURVEY_DEPTH_AB=19.0
COSMOS_CORS_ORIGINS=http://localhost:3000 # only needed if the browser calls the API directly
COSMOS_RATE_LIMIT_PER_MIN=120             # per client, data endpoints only; 0 turns it off
COSMOS_CACHE_DIR=/tmp/cosmos-cache
